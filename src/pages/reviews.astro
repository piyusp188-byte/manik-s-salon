---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { SITE_CONFIG, TESTIMONIALS } from '../data/siteData';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Reviews', url: '/reviews/' }
];
---

<BaseLayout
  title={`Client Reviews | Monik's Salon & Academy, Mahad | 4.7 ★ Google Rating`}
  description="Read authentic client testimonials for Monik's Salon & Academy in Mahad. 4.7 stars from 218 reviews on Google. Celebrating skin-tone matching, pocket-friendly rates, and friendly academy teaching."
>
  <Breadcrumb items={breadcrumbs} />

  <!-- Page Header -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center border-b border-stone-800/80">
    <!-- Star summary badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-4">
      <div class="flex text-amber-400">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <span>4.7 Rating &bull; 218 Reviews on Google</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-serif font-bold text-stone-100 mt-2">
      Client Reviews &amp; Testimonials
    </h1>
    <p class="text-xs sm:text-sm text-stone-300 max-w-2xl mx-auto mt-3 leading-relaxed">
      Authentic feedback from clients and academy students in Mahad. We pride ourselves on creating positive experiences, genuine friendship, and stunning beauty results.
    </p>

    <div class="mt-8">
      <a
        href={SITE_CONFIG.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-stone-950 bg-gradient-to-r from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 shadow-md transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
        </svg>
        Read All 218 Reviews on Google Maps &rarr;
      </a>
    </div>
  </section>

  <!-- Review Cards Section -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {TESTIMONIALS.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} />
      ))}
    </div>

    <!-- Review Themes Summary -->
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      <div class="p-4 rounded-xl bg-stone-900/60 border border-stone-800 text-center">
        <span class="block text-amber-300 font-serif font-bold text-lg">Quality Work</span>
        <span class="block text-xs text-stone-400 mt-1">Superb skincare demos &amp; clean makeup</span>
      </div>
      <div class="p-4 rounded-xl bg-stone-900/60 border border-stone-800 text-center">
        <span class="block text-amber-300 font-serif font-bold text-lg">Friendly &amp; Nice Staff</span>
        <span class="block text-xs text-stone-400 mt-1">Comfortable, patient, and welcoming</span>
      </div>
      <div class="p-4 rounded-xl bg-stone-900/60 border border-stone-800 text-center">
        <span class="block text-amber-300 font-serif font-bold text-lg">Pocket-Friendly</span>
        <span class="block text-xs text-stone-400 mt-1">Accessible rates for Mahad community</span>
      </div>
      <div class="p-4 rounded-xl bg-stone-900/60 border border-stone-800 text-center">
        <span class="block text-amber-300 font-serif font-bold text-lg">Taught Like a Friend</span>
        <span class="block text-xs text-stone-400 mt-1">No pressure, easy-to-follow steps</span>
      </div>
    </div>

    <!-- Leave a Review Callout -->
    <div class="mt-16 p-8 rounded-2xl bg-stone-900/40 border border-stone-800 text-center max-w-2xl mx-auto">
      <h3 class="text-xl font-serif font-bold text-stone-100">
        Have You Visited Monik's Salon &amp; Academy?
      </h3>
      <p class="text-xs sm:text-sm text-stone-400 mt-2">
        Your feedback helps our women-owned business grow and helps other women in Mahad discover quality beauty care.
      </p>
      <div class="mt-6">
        <a
          href={SITE_CONFIG.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-stone-950 bg-amber-400 hover:bg-amber-300 transition-colors shadow"
        >
          Leave Us a Google Review &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
