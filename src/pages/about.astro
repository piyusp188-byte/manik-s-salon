---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_CONFIG, WHY_CHOOSE_US } from '../data/siteData';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
];
---

<BaseLayout
  title={`About Monik's Salon & Academy | Women-Owned Salon in Mahad`}
  description="Discover the story behind Monik's Salon & Academy in Mahad. Women-owned, 4.7★ Google rated, committed to skin-tone-matched makeup, holistic beauty care, and friendly academy mentorship."
>
  <Breadcrumb items={breadcrumbs} />

  <!-- About Hero -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center border-b border-[#E8D9DE]" aria-labelledby="about-title">
    <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
      Our Story &amp; Values
    </span>
    <h1 id="about-title" class="text-3xl sm:text-5xl font-display font-bold text-[#2B2024] mt-4">
      About Monik's Salon &amp; Academy
    </h1>
    <p class="text-sm sm:text-base text-[#5A4553] max-w-2xl mx-auto mt-3 leading-relaxed">
      A women-owned beauty parlour and training sanctuary located on M.G Road, Bazar Peth in Mahad, Maharashtra.
    </p>
  </section>

  <!-- Narrative Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <div class="space-y-8 text-[#5A4553] text-sm leading-relaxed">
      <!-- Section 1 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-[#E8D9DE] shadow-sm">
        <h2 class="text-2xl font-display font-bold text-[#2B2024] mb-3">
          Our Philosophy: Beauty Rooted in Confidence
        </h2>
        <p>
          At <strong>{SITE_CONFIG.businessName}</strong>, we believe that true beauty care is never about masking who you are — it is about enhancing your individuality and boosting your inner confidence. From our signature skin-tone-matched makeup applications to relaxing hydra facials and traditional henna designs, every treatment is tailored to the person sitting in our chair.
        </p>
      </div>

      <!-- Section 2: Women-Owned & Safe Space -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-[#E8D9DE] shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
          <h2 class="text-2xl font-display font-bold text-[#2B2024]">
            A Proudly Women-Owned Sanctuary
          </h2>
        </div>
        <p>
          We take immense pride in being an officially identified women-owned and women-operated establishment. We have created a warm, hygienic, and judgment-free space where women of all ages can unwind, feel pampered, and receive authentic beauty guidance.
        </p>
      </div>

      <!-- Section 3: The Academy Vision -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-[#E8D9DE] shadow-sm">
        <h2 class="text-2xl font-display font-bold text-[#2B2024] mb-3">
          Education: Taught Like a Friend, Not a Teacher
        </h2>
        <p>
          Our Academy was created to bridge the gap between expensive, rigid beauty training and accessible, warm mentorship. As praised by our students in over 218 Google reviews, Monika ma'am and the team explain every product ingredient and application step patiently. Whether you want to master basic makeup for your everyday routine or launch your own beauty career, you are welcomed here as family.
        </p>
      </div>

      <!-- Visual Sanctuary Showcase -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        <div class="rounded-3xl overflow-hidden bg-white border border-[#E8D9DE] shadow-sm group">
          <div class="aspect-[16/10] overflow-hidden bg-[#FBEFF1]">
            <img
              src="/images/gallery/salon-interior.webp"
              alt="Interior ambience of Monik's Salon & Academy in Mahad"
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-6">
            <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full inline-block mb-2">
              The Space
            </span>
            <h3 class="text-lg font-display font-bold text-[#2B2024]">
              A Comfortable &amp; Hygienic Setting
            </h3>
            <p class="text-xs text-[#5A4553] mt-1.5 leading-relaxed">
              Thoughtfully organized styling chairs, vanity mirrors, and private consultation stations inside Budget Food Store building, Navipeth, Mahad.
            </p>
          </div>
        </div>

        <div class="rounded-3xl overflow-hidden bg-white border border-[#E8D9DE] shadow-sm group">
          <div class="aspect-[16/10] overflow-hidden bg-[#FBEFF1]">
            <img
              src="/images/gallery/shade-matching.webp"
              alt="Skin tone matching and consultation at Monik's Salon"
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-6">
            <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full inline-block mb-2">
              Our Approach
            </span>
            <h3 class="text-lg font-display font-bold text-[#2B2024]">
              Personalized Skin &amp; Shade Matching
            </h3>
            <p class="text-xs text-[#5A4553] mt-1.5 leading-relaxed">
              Every face is unique. We take the time to test undertones and recommend formulations that feel natural, breathable, and genuinely flattering.
            </p>
          </div>
        </div>
      </div>

      <!-- Placeholder Notice for Owner's Personal Bio -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#FFF9F5] border border-dashed border-[#E8D9DE] text-xs sm:text-sm">
        <h3 class="font-display font-bold text-[#6B2D5E] text-base mb-1.5 flex items-center gap-2">
          <svg class="w-4 h-4 text-[#C4845A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Owner Information Placeholder
        </h3>
        <p class="text-[#5A4553] leading-relaxed">
          <strong class="text-[#2B2024]">Open Information to be supplied:</strong> Exact founding year, Monika ma'am's formal certifications or background story, and staff bios will be added here once confirmed by the owner. To maintain complete integrity, no biographical claims or staff names are invented.
        </p>
      </div>
    </div>

    <!-- Core Values Grid -->
    <div class="mt-16 pt-12 border-t border-[#E8D9DE]">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-[#2B2024] text-center mb-8">
        The Values We Live By
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {WHY_CHOOSE_US.map((item) => (
          <div class="p-5 rounded-2xl bg-white border border-[#E8D9DE] shadow-sm">
            <h3 class="text-base font-display font-bold text-[#6B2D5E] mb-1">{item.title}</h3>
            <p class="text-xs text-[#5A4553] leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
