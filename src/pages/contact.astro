---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_CONFIG, SERVICES, COURSES } from '../data/siteData';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' }
];
---

<BaseLayout
  title={`Contact & Location | Monik's Salon & Academy, Mahad Maharashtra`}
  description="Contact Monik's Salon & Academy in Mahad. Located on M.G Road, Bazar Peth, near Ratrani (Budget Food Store). Phone: +91 84460 03385. Open 10 AM – 8 PM. Map, directions & booking form."
>
  <Breadcrumb items={breadcrumbs} />

  <!-- Page Header -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center border-b border-[#E8D9DE]" aria-labelledby="contact-title">
    <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
      Find Us in Mahad
    </span>
    <h1 id="contact-title" class="text-3xl sm:text-5xl font-display font-bold text-[#2B2024] mt-4">
      Contact &amp; Location
    </h1>
    <p class="text-sm sm:text-base text-[#5A4553] max-w-2xl mx-auto mt-3 leading-relaxed">
      Have a question about our services, bridal bookings, or academy batches? Visit us, call, or message us directly on WhatsApp.
    </p>
  </section>

  <!-- Two Column Layout: Details & Form + Map -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Col 1: NAP Details & Quick Links -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-display font-bold text-[#2B2024]">
            Visit Our Salon
          </h2>
          <p class="text-xs sm:text-sm text-[#5A4553] mt-1">
            Centrally located in Bazar Peth, Navipeth, Mahad.
          </p>
        </div>

        <!-- Address Card -->
        <div class="p-6 rounded-3xl bg-white border border-[#E8D9DE] text-xs sm:text-sm space-y-3.5 shadow-sm">
          <div class="flex items-start gap-3.5">
            <svg class="w-5 h-5 text-[#6B2D5E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <strong class="text-[#2B2024] block font-bold text-base font-display">Monik's Salon &amp; Academy</strong>
              <p class="text-[#5A4553] mt-1 leading-relaxed">
                {SITE_CONFIG.address.street},<br />
                {SITE_CONFIG.address.locality}, {SITE_CONFIG.address.city},<br />
                {SITE_CONFIG.address.state} &ndash; {SITE_CONFIG.address.postalCode}
              </p>
              <p class="text-[#2B2024] text-xs mt-2 font-medium">
                <strong class="text-[#6B2D5E]">Landmark:</strong> Near Ratrani, located inside Budget Food Store.
              </p>
              <p class="text-[#7A6672] text-[11px] mt-0.5">
                Plus Code: {SITE_CONFIG.address.plusCode}
              </p>
            </div>
          </div>
        </div>

        <!-- Phone & WhatsApp Card -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href={`tel:${SITE_CONFIG.phoneTel}`}
            class="p-5 rounded-2xl bg-white border border-[#E8D9DE] hover:border-[#6B2D5E] transition-colors flex items-center gap-3.5 shadow-sm"
          >
            <div class="w-10 h-10 rounded-xl bg-[#FBEFF1] border border-[#E8D9DE] flex items-center justify-center text-[#6B2D5E] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="block text-[11px] uppercase tracking-wider text-[#7A6672] font-semibold">Direct Call</span>
              <span class="text-sm font-bold text-[#2B2024]">{SITE_CONFIG.phoneInternational}</span>
            </div>
          </a>

          <a
            href={`https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${encodeURIComponent(SITE_CONFIG.whatsappDefaultMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 hover:border-emerald-500 transition-colors flex items-center gap-3.5 shadow-sm"
          >
            <div class="w-10 h-10 rounded-xl bg-[#25D366] text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              </svg>
            </div>
            <div>
              <span class="block text-[11px] uppercase tracking-wider text-emerald-800 font-semibold">WhatsApp Chat</span>
              <span class="text-sm font-bold text-emerald-900">Message Now</span>
            </div>
          </a>
        </div>

        <!-- Hours Card -->
        <div class="p-6 rounded-3xl bg-white border border-[#E8D9DE] text-xs sm:text-sm space-y-2.5 shadow-sm">
          <div class="flex items-center gap-2 text-[#2B2024] font-bold text-sm">
            <svg class="w-4 h-4 text-[#6B2D5E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Opening Hours</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[#E8D9DE]/60 text-[#5A4553]">
            <span>Monday &ndash; Saturday</span>
            <span class="font-bold text-[#2B2024]">{SITE_CONFIG.openingHours.weekdays}</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-[#E8D9DE]/60 text-[#5A4553]">
            <span>Sunday</span>
            <span class="font-bold text-[#2B2024]">{SITE_CONFIG.openingHours.sundays}</span>
          </div>
          <p class="text-xs text-[#C4845A] font-semibold pt-1 leading-relaxed">
            *{SITE_CONFIG.openingHours.festivalNotice}
          </p>
        </div>

        <!-- Directions Button -->
        <div>
          <a
            href={SITE_CONFIG.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] shadow-md transition-all"
          >
            Open in Google Maps Application &rarr;
          </a>
        </div>
      </div>

      <!-- Col 2: Interactive Google Map Embed & On-page Enquiry Form -->
      <div class="space-y-8">
        <!-- Google Map Embed -->
        <div class="rounded-3xl overflow-hidden border border-[#E8D9DE] bg-white aspect-[16/10] shadow-xl relative">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3789.2892976156066!2d73.4145113!3d18.0833!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be8533b37077bc1%3A0xb697dbb69c792f8a!2sMonik&#39;s%20Salon%20%26%20Academy!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Google Map location of Monik's Salon & Academy, Mahad"
            class="w-full h-full"
          ></iframe>
        </div>

        <!-- On-Page Quick Form -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-[#E8D9DE] shadow-sm">
          <h3 class="text-2xl font-display font-bold text-[#2B2024] mb-2">
            Send an Online Enquiry
          </h3>
          <p class="text-xs sm:text-sm text-[#5A4553] mb-5">
            Fill out the form below to generate a pre-filled WhatsApp message directly to our desk.
          </p>

          <form id="contact-page-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
                Your Name *
              </label>
              <input
                type="text"
                id="contact-name"
                required
                placeholder="e.g. Srushti Deshmukh"
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] placeholder:text-[#7A6672]"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="contact-phone" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
                  Phone Number *
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  required
                  placeholder="e.g. 9876543210"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] placeholder:text-[#7A6672]"
                />
              </div>

              <div>
                <label for="contact-service" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
                  Interested In *
                </label>
                <select
                  id="contact-service"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E]"
                >
                  <option value="" disabled selected>-- Select --</option>
                  <optgroup label="Services">
                    {SERVICES.map((s) => (
                      <option value={s.name}>{s.name}</option>
                    ))}
                  </optgroup>
                  <optgroup label="Academy Courses">
                    {COURSES.map((c) => (
                      <option value={c.title}>{c.title}</option>
                    ))}
                  </optgroup>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
                Message (Optional)
              </label>
              <textarea
                id="contact-message"
                rows="3"
                placeholder="Share your preferred date or questions..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] placeholder:text-[#7A6672] resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 px-4 rounded-xl text-white font-bold bg-[#6B2D5E] hover:bg-[#4E1E45] transition-all text-xs uppercase tracking-wider shadow-sm cursor-pointer"
            >
              Send Request to Monik's Salon via WhatsApp
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section with Schema on Contact page as well -->
  <FAQ />
</BaseLayout>

<script define:vars={{ whatsappNumber: SITE_CONFIG.whatsappNumber, businessName: SITE_CONFIG.businessName }}>
  const form = document.getElementById('contact-page-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name')).value;
      const phone = (document.getElementById('contact-phone')).value;
      const service = (document.getElementById('contact-service')).value;
      const message = (document.getElementById('contact-message')).value;

      let text = `Hello *${businessName}*,\n\nI am contacting you from your website contact page:\n`;
      text += `• *Name:* ${name}\n`;
      text += `• *Phone:* ${phone}\n`;
      text += `• *Service/Course:* ${service}\n`;
      if (message) {
        text += `• *Message:* ${message}\n`;
      }
      text += `\nPlease let me know available slots. Thank you!`;

      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
      window.open(waUrl, '_blank');
    });
  }
</script>
