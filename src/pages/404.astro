---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../data/siteData';
---

<BaseLayout
  title={`Page Not Found | ${SITE_CONFIG.businessName}`}
  description="The page you are looking for does not exist. Explore Monik's Salon & Academy services, courses, or contact details in Mahad."
>
  <section class="py-24 sm:py-32 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto text-center">
    <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
      Error 404
    </span>
    <h1 class="text-4xl sm:text-6xl font-display font-bold text-[#2B2024] mt-4">
      Page Not Found
    </h1>
    <p class="text-sm sm:text-base text-[#5A4553] mt-4 max-w-md mx-auto leading-relaxed">
      We couldn't find the page you were looking for. Perhaps you'd like to browse our salon services or explore our academy courses in Mahad.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="px-7 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] shadow-md transition-all"
      >
        Return to Home &rarr;
      </a>
      <a
        href="/services/"
        class="px-7 py-3.5 rounded-xl text-xs font-bold text-[#2B2024] bg-white border border-[#E8D9DE] hover:bg-[#FBEFF1] transition-all"
      >
        View Services Menu
      </a>
    </div>
  </section>
</BaseLayout>
