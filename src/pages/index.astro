---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CourseCard from '../components/CourseCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_CONFIG, SERVICES, COURSES, TESTIMONIALS, WHY_CHOOSE_US, REQUIRED_PHOTOS_LIST } from '../data/siteData';

const featuredServices = SERVICES.slice(0, 4);
const featuredCourses = COURSES.slice(0, 2);
---

<BaseLayout
  title={`${SITE_CONFIG.businessName} | Beauty Parlour, Makeup Artist & Academy in Mahad`}
  description="Monik's Salon & Academy in Mahad, Maharashtra. Expert bridal makeup, skin-tone matching, hydra facials, mehndi designs, and professional beauty academy courses. Rated 4.7★ on Google. Call +91 84460 03385."
>
  <!-- 1. Hero Section with Full-Viewport Background Video -->
  <VideoHero />

  <!-- 2. Trust Strip (Directly below hero: 4.7★ | Women-Owned | Academy | Pocket-Friendly) -->
  <TrustStrip />

  <!-- 3. Key Services Showcase -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-[#E8D9DE]" aria-labelledby="services-heading">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
        Our Beauty Offerings
      </span>
      <h2 id="services-heading" class="text-3xl sm:text-4xl font-display font-bold text-[#2B2024] mt-3">
        Specialized Salon Services in Mahad
      </h2>
      <p class="text-sm sm:text-base text-[#5A4553] mt-3 leading-relaxed">
        From skin-tone-matched bridal transformations to deep revitalizing hydra facials, explore our bespoke treatments designed for your natural radiance.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {featuredServices.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>

    <div class="text-center mt-10 sm:mt-12">
      <a
        href="/services/"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] shadow-md transition-all"
      >
        View Complete Services Menu ({SERVICES.length} Categories) &rarr;
      </a>
    </div>
  </section>

  <!-- 4. Academy Teaser Section -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#FBEFF1] border-b border-[#E8D9DE]" aria-labelledby="academy-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 mb-12">
        <div class="max-w-2xl">
          <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-white border border-[#E8D9DE] rounded-full">
            Beauty Education
          </span>
          <h2 id="academy-heading" class="text-3xl sm:text-4xl font-display font-bold text-[#2B2024] mt-3">
            Learn with Confidence at Monik's Academy
          </h2>
          <p class="text-sm sm:text-base text-[#5A4553] mt-3 leading-relaxed">
            Our students describe learning here as being <strong class="text-[#6B2D5E] font-semibold">&ldquo;taught like a friend, not a teacher.&rdquo;</strong> Gain hands-on practical skills in makeup, mehndi, skin care, and hair styling in an encouraging, welcoming atmosphere.
          </p>
        </div>

        <a
          href="/academy/"
          class="px-7 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] shadow-md transition-all shrink-0"
        >
          Explore All Academy Courses &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredCourses.map((course) => (
          <CourseCard course={course} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Why Choose Us (Pillars) -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-[#E8D9DE]" aria-labelledby="why-heading">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
        The Monik's Standard
      </span>
      <h2 id="why-heading" class="text-3xl sm:text-4xl font-display font-bold text-[#2B2024] mt-3">
        Why Mahad Loves Monik's Salon &amp; Academy
      </h2>
      <p class="text-sm sm:text-base text-[#5A4553] mt-3">
        Honest values, certified expertise, and an authentic, welcoming environment tailored for you.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {WHY_CHOOSE_US.map((item) => (
        <div class="p-6 rounded-2xl bg-white border border-[#E8D9DE] hover:border-[#6B2D5E]/50 transition-colors shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-[#FBEFF1] border border-[#E8D9DE] flex items-center justify-center text-[#6B2D5E] mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-[#2B2024] mb-1.5">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-[#5A4553] leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- 6. Client Testimonials (Google 4.7 Rating) -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#FFF9F5] border-b border-[#E8D9DE]" aria-labelledby="reviews-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <div class="flex text-[#E8A020]">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="text-xs font-bold text-[#6B2D5E]">4.7 / 5.0 Rating</span>
          </div>
          <h2 id="reviews-heading" class="text-3xl sm:text-4xl font-display font-bold text-[#2B2024]">
            Real Words from Real Clients
          </h2>
          <p class="text-sm sm:text-base text-[#5A4553] mt-2">
            218 authentic reviews on Google praise our personalized care, patient teaching, and pocket-friendly rates.
          </p>
        </div>

        <a
          href={SITE_CONFIG.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#6B2D5E] hover:underline transition-colors"
        >
          View all 218 reviews on Google Maps &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {TESTIMONIALS.map((t) => (
          <TestimonialCard testimonial={t} />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Real Work Gallery Preview (Neutral Placeholders) -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-[#E8D9DE]" aria-labelledby="gallery-heading">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
        Visual Showcase
      </span>
      <h2 id="gallery-heading" class="text-3xl sm:text-4xl font-display font-bold text-[#2B2024] mt-3">
        Our Artistry in Pictures
      </h2>
      <p class="text-sm sm:text-base text-[#5A4553] mt-3">
        We never use fake stock photos. Below are designated showcase slots ready for the salon owner's real photography.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {REQUIRED_PHOTOS_LIST.slice(0, 4).map((item) => (
        <div class="aspect-square rounded-2xl bg-white border border-dashed border-[#E8D9DE] p-4 flex flex-col items-center justify-center text-center group hover:border-[#6B2D5E]/60 transition-colors shadow-sm">
          <div class="w-12 h-12 rounded-full bg-[#FBEFF1] flex items-center justify-center text-[#6B2D5E] mb-3 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <span class="text-sm font-display font-bold text-[#2B2024]">
            {item.category}
          </span>
          <span class="text-[10px] text-[#C4845A] font-semibold mt-1">
            [Real Photo Needed]
          </span>
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href="/gallery/" class="text-xs font-bold text-[#6B2D5E] hover:underline">
        Browse Full Work Gallery &amp; Photo Checklist &rarr;
      </a>
    </div>
  </section>

  <!-- 8. FAQ Section with FAQPage Schema -->
  <FAQ />

  <!-- 9. Location & Working Hours Quick Contact -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-[#E8D9DE]" aria-labelledby="location-heading">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <span class="px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
          Visit Us in Mahad
        </span>
        <h2 id="location-heading" class="text-3xl sm:text-4xl font-display font-bold text-[#2B2024] mt-3">
          Conveniently Located in Bazar Peth
        </h2>
        <p class="text-sm sm:text-base text-[#5A4553] mt-4 leading-relaxed">
          Situated on M.G Road near Ratrani inside the Budget Food Store building, Navipeth, Mahad. Drop by for beauty consultations, hair appointments, or to enrol in our upcoming academy batches.
        </p>

        <div class="mt-6 space-y-3.5 text-xs sm:text-sm text-[#5A4553]">
          <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#E8D9DE] shadow-sm">
            <svg class="w-5 h-5 text-[#6B2D5E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <strong class="text-[#2B2024] block font-bold">Address:</strong>
              {SITE_CONFIG.address.street}, {SITE_CONFIG.address.locality}, {SITE_CONFIG.address.city}, Maharashtra {SITE_CONFIG.address.postalCode}
              <span class="block text-xs text-[#7A6672] mt-0.5">Plus Code: {SITE_CONFIG.address.plusCode}</span>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#E8D9DE] shadow-sm">
            <svg class="w-5 h-5 text-[#6B2D5E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <strong class="text-[#2B2024] block font-bold">Working Hours:</strong>
              <span>Daily: 10:00 AM &ndash; 8:00 PM (Opens 9:00 AM on Sundays)</span>
              <span class="block text-xs text-[#C4845A] font-semibold mt-0.5">*Festival/Diwali hours may vary. Call ahead to confirm.</span>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={SITE_CONFIG.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] transition-colors shadow"
          >
            Open in Google Maps &rarr;
          </a>
          <a
            href={`tel:${SITE_CONFIG.phoneTel}`}
            class="px-6 py-3 rounded-xl text-xs font-bold text-[#2B2024] bg-white border border-[#E8D9DE] hover:bg-[#FBEFF1] transition-colors"
          >
            Call {SITE_CONFIG.phoneInternational}
          </a>
        </div>
      </div>

      <!-- Map Embed Container -->
      <div class="rounded-3xl overflow-hidden border border-[#E8D9DE] bg-white aspect-video lg:aspect-square shadow-xl relative">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3789.2892976156066!2d73.4145113!3d18.0833!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be8533b37077bc1%3A0xb697dbb69c792f8a!2sMonik&#39;s%20Salon%20%26%20Academy!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Map showing location of Monik's Salon & Academy in Mahad, Maharashtra"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- 10. Final CTA Banner -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center" aria-labelledby="cta-heading">
    <div class="rounded-3xl bg-gradient-to-br from-[#6B2D5E] to-[#4E1E45] p-8 sm:p-14 text-white shadow-xl relative overflow-hidden">
      <span class="inline-block px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-rose-200 bg-white/10 border border-white/20 rounded-full mb-3">
        Experience the Transformation
      </span>
      <h2 id="cta-heading" class="text-3xl sm:text-5xl font-display font-bold text-white max-w-2xl mx-auto">
        Ready for Your Personalized Beauty Experience?
      </h2>
      <p class="text-sm sm:text-base text-rose-100/90 mt-4 max-w-xl mx-auto">
        Book your appointment or inquire about upcoming academy batches today. Our friendly team is ready to welcome you.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <button
          type="button"
          onclick="window.openEnquiryModal()"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider text-[#2B2024] bg-white hover:bg-rose-50 shadow-xl transition-all cursor-pointer"
        >
          Book Appointment Now
        </button>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${encodeURIComponent(SITE_CONFIG.whatsappDefaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-xs uppercase tracking-wider text-white bg-[#25D366] hover:bg-[#20ba59] transition-colors"
        >
          WhatsApp Instant Chat
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
