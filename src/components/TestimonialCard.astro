---
import type { ReviewItem } from '../data/siteData';

interface Props {
  testimonial: ReviewItem;
}

const { testimonial } = Astro.props;
---

<figure class="flex flex-col justify-between rounded-2xl bg-stone-900/60 border border-stone-800/80 p-6 sm:p-7 shadow-lg relative">
  <div>
    <!-- Rating Stars -->
    <div class="flex items-center gap-1 mb-3 text-amber-400" aria-label={`Rating: ${testimonial.rating} out of 5 stars`}>
      {Array.from({ length: testimonial.rating }).map(() => (
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>

    <!-- Highlight Quote -->
    <blockquote class="text-sm sm:text-base font-serif italic text-amber-200/95 leading-relaxed mb-3">
      &ldquo;{testimonial.highlight}&rdquo;
    </blockquote>

    <!-- Full text -->
    <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
      {testimonial.text}
    </p>
  </div>

  <figcaption class="mt-6 pt-4 border-t border-stone-800/80 flex items-center justify-between text-xs">
    <div>
      <span class="block font-semibold text-stone-100">{testimonial.author}</span>
      <span class="block text-[11px] text-amber-400/80">{testimonial.serviceMentioned}</span>
    </div>
    <span class="px-2 py-0.5 text-[10px] font-medium text-stone-400 bg-stone-950 rounded border border-stone-800">
      {testimonial.source}
    </span>
  </figcaption>
</figure>
