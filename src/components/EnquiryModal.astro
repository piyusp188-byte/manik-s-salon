---
import { SITE_CONFIG, SERVICES, COURSES } from '../data/siteData';
---

<div
  id="enquiry-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="relative w-full max-w-lg bg-white border border-[#E8D9DE] rounded-3xl shadow-2xl p-6 sm:p-8 overflow-y-auto max-h-[90vh]">
    <!-- Close button -->
    <button
      id="modal-close-btn"
      type="button"
      class="absolute top-5 right-5 p-2 text-[#7A6672] hover:text-[#2B2024] rounded-full hover:bg-[#FBEFF1] transition-colors focus:outline-none focus:ring-2 focus:ring-[#6B2D5E]"
      aria-label="Close booking modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-5">
      <span class="inline-block px-3 py-1 text-[11px] font-bold text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full mb-2">
        Direct Booking &amp; Course Enquiry
      </span>
      <h3 id="modal-title" class="text-2xl font-display font-bold text-[#2B2024]">
        Book an Appointment or Course
      </h3>
      <p class="text-xs sm:text-sm text-[#5A4553] mt-1">
        Send your booking request directly to our team via WhatsApp. We will confirm your slot promptly.
      </p>
    </div>

    <form id="booking-form" class="space-y-4">
      <div>
        <label for="modal-name" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
          Full Name <span class="text-[#6B2D5E]">*</span>
        </label>
        <input
          type="text"
          id="modal-name"
          name="name"
          required
          placeholder="e.g. Priya Sharma"
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] focus:border-[#6B2D5E] placeholder:text-[#7A6672]"
        />
      </div>

      <div>
        <label for="modal-phone" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
          Phone Number <span class="text-[#6B2D5E]">*</span>
        </label>
        <input
          type="tel"
          id="modal-phone"
          name="phone"
          required
          placeholder="e.g. 9876543210"
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] focus:border-[#6B2D5E] placeholder:text-[#7A6672]"
        />
      </div>

      <div>
        <label for="modal-service" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
          Select Service or Academy Course <span class="text-[#6B2D5E]">*</span>
        </label>
        <select
          id="modal-service"
          name="service"
          required
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] focus:border-[#6B2D5E]"
        >
          <option value="" disabled selected>-- Choose Service or Course --</option>
          <optgroup label="Salon Services">
            {SERVICES.map((s) => (
              <option value={`Service: ${s.name}`}>{s.name}</option>
            ))}
          </optgroup>
          <optgroup label="Academy Courses">
            {COURSES.map((c) => (
              <option value={`Academy Course: ${c.title}`}>{c.title}</option>
            ))}
          </optgroup>
          <option value="General Beauty Consultation">General Consultation / Other</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="modal-date" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
            Preferred Date
          </label>
          <input
            type="date"
            id="modal-date"
            name="date"
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] focus:border-[#6B2D5E]"
          />
        </div>

        <div>
          <label for="modal-time" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
            Preferred Time Slot
          </label>
          <select
            id="modal-time"
            name="time"
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] focus:border-[#6B2D5E]"
          >
            <option value="Anytime (10 AM - 8 PM)">Anytime (10 AM &ndash; 8 PM)</option>
            <option value="Morning (10:00 AM - 1:00 PM)">Morning (10:00 AM &ndash; 1:00 PM)</option>
            <option value="Afternoon (1:00 PM - 4:00 PM)">Afternoon (1:00 PM &ndash; 4:00 PM)</option>
            <option value="Evening (4:00 PM - 8:00 PM)">Evening (4:00 PM &ndash; 8:00 PM)</option>
          </select>
        </div>
      </div>

      <div>
        <label for="modal-notes" class="block text-xs font-bold text-[#2B2024] uppercase tracking-wider mb-1">
          Special Notes / Questions (Optional)
        </label>
        <textarea
          id="modal-notes"
          name="notes"
          rows="2"
          placeholder="e.g. Skin concerns, bridal date, or course batch inquiry..."
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-[#2B2024] text-sm focus:outline-none focus:ring-2 focus:ring-[#6B2D5E] focus:border-[#6B2D5E] placeholder:text-[#7A6672] resize-none"
        ></textarea>
      </div>

      <div class="pt-2 space-y-3">
        <button
          type="submit"
          class="w-full py-3.5 px-4 rounded-xl text-white font-semibold bg-[#25D366] hover:bg-[#20ba59] transition-all shadow-lg shadow-emerald-900/20 flex items-center justify-center gap-2 text-sm cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          Send Booking via WhatsApp
        </button>

        <div class="flex items-center justify-between text-xs text-[#5A4553] px-1 pt-1">
          <span>Or call directly:</span>
          <a href={`tel:${SITE_CONFIG.phoneTel}`} class="text-[#6B2D5E] font-bold hover:underline">
            {SITE_CONFIG.phoneInternational}
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ whatsappNumber: SITE_CONFIG.whatsappNumber, businessName: SITE_CONFIG.businessName }}>
  const modal = document.getElementById('enquiry-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const form = document.getElementById('booking-form');

  const closeModal = () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }
  };

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }

  // Close on outside backdrop click
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Handle WhatsApp form submission
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('modal-name')).value;
      const phone = (document.getElementById('modal-phone')).value;
      const service = (document.getElementById('modal-service')).value;
      const date = (document.getElementById('modal-date')).value || 'Flexible';
      const time = (document.getElementById('modal-time')).value || 'Anytime';
      const notes = (document.getElementById('modal-notes')).value;

      let message = `Hello *${businessName}*,\n\nI would like to book / enquire:\n`;
      message += `• *Name:* ${name}\n`;
      message += `• *Phone:* ${phone}\n`;
      message += `• *Interest:* ${service}\n`;
      message += `• *Preferred Date:* ${date}\n`;
      message += `• *Preferred Time:* ${time}\n`;
      if (notes) {
        message += `• *Notes:* ${notes}\n`;
      }
      message += `\nPlease confirm availability. Thank you!`;

      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
      closeModal();
    });
  }
</script>
