---
import { SITE_CONFIG } from '../data/siteData';
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center justify-center overflow-hidden bg-stone-950 border-b border-stone-800">
  <!-- Background Video Container with Fallback Poster -->
  <div class="absolute inset-0 w-full h-full overflow-hidden select-none">
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      poster="/images/hero-poster.svg"
      class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover transition-opacity duration-1000 opacity-60"
      aria-hidden="true"
    >
      <!-- High quality aesthetic salon footage (royalty-free salon styling & makeup video loop) -->
      <source src="https://assets.mixkit.co/videos/preview/mixkit-hairdresser-brushing-the-hair-of-a-brunette-woman-41584-large.mp4" type="video/mp4" />
      <source src="/videos/salon-hero.mp4" type="video/mp4" />
      Your browser does not support HTML5 video.
    </video>

    <!-- Deep Luxury Gradient Overlays for High-Contrast Text Legibility (WCAG AAA compliant) -->
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/75 to-stone-950/50"></div>
    <div class="absolute inset-0 bg-radial-at-c from-transparent via-stone-950/40 to-stone-950/90"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(212,175,55,0.15),rgba(255,255,255,0))]"></div>
  </div>

  <!-- Hero Content Overlay -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center">
    <!-- Trust badges row -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 mb-6">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold tracking-wide text-amber-200 bg-amber-500/15 border border-amber-500/30 rounded-full backdrop-blur-md">
        <svg class="w-3.5 h-3.5 text-amber-400 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        4.7 Stars on Google &bull; 218 Reviews
      </span>

      <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium text-stone-300 bg-stone-900/70 border border-stone-800 rounded-full backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Open 10 AM &ndash; 8 PM &bull; Navipeth, Mahad
      </span>

      <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium text-amber-300/90 bg-amber-950/40 border border-amber-800/40 rounded-full backdrop-blur-md">
        Women-Owned Business
      </span>
    </div>

    <!-- Main H1 with Luxury Typography -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-stone-100 max-w-4xl mx-auto leading-[1.15]">
      Your Beauty, <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500">Your Confidence.</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-5 sm:mt-6 text-base sm:text-lg lg:text-xl text-stone-300 max-w-2xl mx-auto font-normal leading-relaxed">
      Welcome to <strong class="text-stone-100 font-semibold">{SITE_CONFIG.businessName}</strong>. Mahad&rsquo;s trusted salon for skin-tone-matched bridal makeup, hydra facials, mehndi artistry, and hands-on beauty courses.
    </p>

    <!-- CTAs -->
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto sm:max-w-none">
      <button
        type="button"
        onclick="window.openEnquiryModal()"
        class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-stone-950 text-sm tracking-wide bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 shadow-xl shadow-amber-500/20 hover:shadow-amber-500/30 transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
      >
        Book an Appointment
      </button>

      <a
        href="/academy/"
        class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-stone-200 text-sm tracking-wide bg-stone-900/90 hover:bg-stone-800 border border-amber-500/30 hover:border-amber-400/60 shadow-lg backdrop-blur-md transition-all duration-200"
      >
        Explore Academy Courses &rarr;
      </a>
    </div>

    <!-- Review themes pills -->
    <div class="mt-10 sm:mt-12 pt-8 border-t border-stone-800/80 max-w-3xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
      <div class="bg-stone-900/50 border border-stone-800/80 rounded-lg p-2.5 backdrop-blur-sm">
        <span class="block text-amber-300 text-xs font-semibold">Skin-Tone Matching</span>
        <span class="block text-[11px] text-stone-400">Flawless, seamless blend</span>
      </div>
      <div class="bg-stone-900/50 border border-stone-800/80 rounded-lg p-2.5 backdrop-blur-sm">
        <span class="block text-amber-300 text-xs font-semibold">Pocket-Friendly</span>
        <span class="block text-[11px] text-stone-400">Honest, fair pricing</span>
      </div>
      <div class="bg-stone-900/50 border border-stone-800/80 rounded-lg p-2.5 backdrop-blur-sm">
        <span class="block text-amber-300 text-xs font-semibold">Taught Like a Friend</span>
        <span class="block text-[11px] text-stone-400">Patient, supportive training</span>
      </div>
      <div class="bg-stone-900/50 border border-stone-800/80 rounded-lg p-2.5 backdrop-blur-sm">
        <span class="block text-amber-300 text-xs font-semibold">Quality Care</span>
        <span class="block text-[11px] text-stone-400">Hydra facial &amp; hair care</span>
      </div>
    </div>
  </div>

  <!-- Video Play / Pause / Mute accessible controls in corner -->
  <div class="absolute bottom-4 right-4 z-20 flex items-center gap-2 bg-stone-900/80 border border-stone-800 rounded-full p-1.5 backdrop-blur-md">
    <button
      id="video-toggle-btn"
      type="button"
      class="p-1.5 text-stone-300 hover:text-white rounded-full hover:bg-stone-800 focus:outline-none focus:ring-1 focus:ring-amber-400"
      aria-label="Pause background video"
      title="Pause background video"
    >
      <svg id="pause-icon" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <svg id="play-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>
</section>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggleBtn = document.getElementById('video-toggle-btn');
  const pauseIcon = document.getElementById('pause-icon');
  const playIcon = document.getElementById('play-icon');

  if (video && toggleBtn && pauseIcon && playIcon) {
    // Respect prefers-reduced-motion
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mediaQuery.matches) {
      video.pause();
      pauseIcon.classList.add('hidden');
      playIcon.classList.remove('hidden');
      toggleBtn.setAttribute('aria-label', 'Play background video');
    }

    toggleBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        pauseIcon.classList.remove('hidden');
        playIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-label', 'Pause background video');
      } else {
        video.pause();
        pauseIcon.classList.add('hidden');
        playIcon.classList.remove('hidden');
        toggleBtn.setAttribute('aria-label', 'Play background video');
      }
    });
  }
</script>
