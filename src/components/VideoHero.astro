---
import { SITE_CONFIG } from '../data/siteData';
---

<section
  class="video-hero"
  aria-label="Monik's Salon & Academy — beauty parlour and academy in Mahad"
>
  <!-- Decorative ambient video loop (hidden from assistive tech) -->
  <video
    id="hero-video"
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/hero/poster-desktop.webp"
    aria-hidden="true"
    tabindex="-1"
  >
    <source id="src-desktop-webm" src="/video/hero-desktop.webm" type="video/webm" />
    <source id="src-desktop-mp4" src="/video/hero-desktop.mp4" type="video/mp4" />
  </video>

  <!-- Dark plum gradient overlay calibrated for WCAG AAA text contrast -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Real HTML Text & Action Buttons -->
  <div class="hero-content">
    <!-- Star Rating line -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 text-xs sm:text-sm font-medium tracking-wide text-amber-200">
      <span class="text-amber-300 font-bold tracking-wider" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#189;</span>
      <span>4.7 &bull; 218 Google Reviews</span>
      <span class="text-white/40 hidden sm:inline">&bull;</span>
      <span class="text-white/90 hidden sm:inline">Women-Owned</span>
    </div>

    <!-- Main H1 targeting Mahad local beauty & academy searches -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-semibold tracking-tight text-white max-w-4xl mx-auto leading-[1.12]">
      Beauty Parlour, Makeup Artist &amp; Academy in Mahad
    </h1>

    <!-- Location & Brand Subtext -->
    <p class="mt-4 sm:mt-5 text-base sm:text-lg lg:text-xl text-rose-100/90 max-w-2xl mx-auto font-normal leading-relaxed">
      <strong>{SITE_CONFIG.businessName}</strong> &mdash; M.G Road, Bazar Peth, Navipeth, Mahad, Maharashtra. Skin-tone-matched makeup, hydra facials, mehndi artistry &amp; hands-on beauty courses.
    </p>

    <!-- CTAs: WhatsApp, Directions, Call -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-lg mx-auto" role="group" aria-label="Contact options">
      <a
        href={`https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${encodeURIComponent(SITE_CONFIG.whatsappDefaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-white bg-[#25D366] hover:bg-[#20ba59] shadow-lg shadow-emerald-900/30 transition-all duration-200 text-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
        <span>WhatsApp Us</span>
      </a>

      <a
        href={SITE_CONFIG.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-medium text-white bg-white/15 hover:bg-white/25 border border-white/30 backdrop-blur-md transition-all duration-200 text-sm"
      >
        <svg class="w-4 h-4 text-rose-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Get Directions</span>
      </a>

      <a
        href={`tel:${SITE_CONFIG.phoneTel}`}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-medium text-white bg-white/15 hover:bg-white/25 border border-white/30 backdrop-blur-md transition-all duration-200 text-sm"
      >
        <svg class="w-4 h-4 text-rose-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Now</span>
      </a>
    </div>

    <!-- Quick Hours note -->
    <p class="mt-5 text-xs text-rose-200/80">
      Open Daily 10:00 AM &ndash; 8:00 PM (Opens 9:00 AM Sundays)
    </p>
  </div>

  <!-- Accessible Pause/Play Button (WCAG 2.2.2 requirement for motion > 5s) -->
  <button
    id="hero-pause-btn"
    class="hero-pause-btn"
    type="button"
    aria-label="Pause background video"
    aria-pressed="false"
  >
    <svg id="hero-pause-icon" class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <svg id="hero-play-icon" class="w-4 h-4 fill-current hidden" viewBox="0 0 20 20" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
    </svg>
  </button>
</section>

<!-- Client script for responsive video source swapping, accessibility & power saving -->
<script>
  (function () {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const pauseBtn = document.getElementById('hero-pause-btn');
    const pauseIcon = document.getElementById('hero-pause-icon');
    const playIcon = document.getElementById('hero-play-icon');

    if (!video) return;

    // 1. Check prefers-reduced-motion
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 2. Check Save-Data header or slow connection
    const nav = navigator as any;
    const saveData = nav.connection && nav.connection.saveData;
    const slowConnection = nav.connection && ['slow-2g', '2g', '3g'].includes(nav.connection.effectiveType);

    if (prefersReduced || saveData || slowConnection) {
      video.pause();
      video.removeAttribute('autoplay');
      if (pauseBtn) pauseBtn.style.display = 'none';
      return;
    }

    // 3. Swap to lightweight mobile crop video on screens < 768px
    if (window.innerWidth < 768) {
      video.poster = '/images/hero/poster-mobile.webp';
      video.innerHTML = `
        <source src="/video/hero-mobile.webm" type="video/webm">
        <source src="/video/hero-mobile.mp4" type="video/mp4">
      `;
      video.load();
    }

    // 4. Handle autoplay catch (iOS Low Power Mode gracefully falls back to poster)
    const playPromise = video.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        if (pauseIcon && playIcon) {
          pauseIcon.classList.add('hidden');
          playIcon.classList.remove('hidden');
        }
        if (pauseBtn) {
          pauseBtn.setAttribute('aria-label', 'Play background video');
          pauseBtn.setAttribute('aria-pressed', 'true');
        }
      });
    }

    // 5. IntersectionObserver: pause video when scrolled out of view to save battery/data
    if ('IntersectionObserver' in window) {
      const heroSection = video.closest('.video-hero');
      if (heroSection) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              if (video.paused && pauseBtn?.getAttribute('aria-pressed') !== 'true') {
                video.play().catch(() => {});
              }
            } else {
              if (!video.paused) {
                video.pause();
              }
            }
          },
          { threshold: 0.15 }
        );
        observer.observe(heroSection);
      }
    }

    // 6. Page Visibility API: pause when tab is minimized or switched
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        video.pause();
      } else if (pauseBtn?.getAttribute('aria-pressed') !== 'true') {
        video.play().catch(() => {});
      }
    });

    // 7. Manual Pause / Play control (WCAG 2.2.2)
    if (pauseBtn && pauseIcon && playIcon) {
      pauseBtn.addEventListener('click', () => {
        if (video.paused) {
          video.play().then(() => {
            pauseIcon.classList.remove('hidden');
            playIcon.classList.add('hidden');
            pauseBtn.setAttribute('aria-label', 'Pause background video');
            pauseBtn.setAttribute('aria-pressed', 'false');
          }).catch(() => {});
        } else {
          video.pause();
          pauseIcon.classList.add('hidden');
          playIcon.classList.remove('hidden');
          pauseBtn.setAttribute('aria-label', 'Play background video');
          pauseBtn.setAttribute('aria-pressed', 'true');
        }
      });
    }
  })();
</script>
