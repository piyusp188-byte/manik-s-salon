---
interface Props {
  variant?: 'full' | 'monogram' | 'compact';
  class?: string;
  inverted?: boolean;
}

const { variant = 'full', class: className = '', inverted = false } = Astro.props;
---

{variant === 'monogram' && (
  <svg class={className} viewBox="0 0 100 100" fill="none" role="img" aria-label="Monik's Salon & Academy Monogram">
    <defs>
      <linearGradient id="monoPlumRose" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#8E3E7D" />
        <stop offset="60%" stop-color="#6B2D5E" />
        <stop offset="100%" stop-color="#C4845A" />
      </linearGradient>
    </defs>
    <circle cx="50" cy="50" r="45" stroke="url(#monoPlumRose)" stroke-width="1.5" stroke-dasharray="3 2" />
    <circle cx="50" cy="50" r="40" stroke="url(#monoPlumRose)" stroke-width="1.8" />
    <circle cx="50" cy="7" r="2" fill="url(#monoPlumRose)" />
    <circle cx="50" cy="93" r="2" fill="url(#monoPlumRose)" />
    <circle cx="7" cy="50" r="2" fill="url(#monoPlumRose)" />
    <circle cx="93" cy="50" r="2" fill="url(#monoPlumRose)" />
    <path d="M 28 68 L 28 32 C 28 32, 33 46, 50 63 C 67 46, 72 32, 72 32 L 72 68 M 41 48 L 50 58 L 59 48" 
          stroke="url(#monoPlumRose)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M 42 27 L 50 21 L 58 27 L 55 30 L 45 30 Z" fill="url(#monoPlumRose)" opacity="0.9" />
    <circle cx="50" cy="18" r="1.5" fill="url(#monoPlumRose)" />
  </svg>
)}

{variant === 'compact' && (
  <div class={`flex items-center gap-2.5 ${className}`}>
    <div class="w-9 h-9 shrink-0">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full" aria-hidden="true">
        <defs>
          <linearGradient id="compPlumRose" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#8E3E7D" />
            <stop offset="60%" stop-color="#6B2D5E" />
            <stop offset="100%" stop-color="#C4845A" />
          </linearGradient>
        </defs>
        <circle cx="50" cy="50" r="45" stroke="url(#compPlumRose)" stroke-width="1.8" />
        <path d="M 28 68 L 28 32 C 28 32, 33 46, 50 63 C 67 46, 72 32, 72 32 L 72 68 M 41 48 L 50 58 L 59 48" 
              stroke="url(#compPlumRose)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <div class="leading-tight">
      <span class={`block text-base tracking-[0.16em] font-display font-bold ${inverted ? 'text-white' : 'text-[#6B2D5E]'}`}>
        MONIK'S
      </span>
      <span class={`block text-[10px] tracking-[0.22em] font-medium ${inverted ? 'text-rose-200/80' : 'text-[#5A4553]'}`}>
        SALON &amp; ACADEMY
      </span>
    </div>
  </div>
)}

{variant === 'full' && (
  <div class={`flex items-center gap-3 ${className}`}>
    <div class="w-11 h-11 shrink-0">
      <svg viewBox="0 0 100 100" fill="none" class="w-full h-full" aria-hidden="true">
        <defs>
          <linearGradient id="fullPlumRose" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#8E3E7D" />
            <stop offset="60%" stop-color="#6B2D5E" />
            <stop offset="100%" stop-color="#C4845A" />
          </linearGradient>
        </defs>
        <circle cx="50" cy="50" r="46" stroke="url(#fullPlumRose)" stroke-width="1.5" stroke-dasharray="3 2" />
        <circle cx="50" cy="50" r="41" stroke="url(#fullPlumRose)" stroke-width="1.8" />
        <path d="M 28 68 L 28 32 C 28 32, 33 46, 50 63 C 67 46, 72 32, 72 32 L 72 68 M 41 48 L 50 58 L 59 48" 
              stroke="url(#fullPlumRose)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M 42 27 L 50 21 L 58 27 L 55 30 L 45 30 Z" fill="url(#fullPlumRose)" opacity="0.9" />
        <circle cx="50" cy="18" r="1.5" fill="url(#fullPlumRose)" />
      </svg>
    </div>
    <div class="flex flex-col">
      <span class={`text-lg md:text-xl tracking-[0.16em] font-display font-bold leading-tight ${inverted ? 'text-white' : 'text-[#6B2D5E]'}`}>
        MONIK'S
      </span>
      <span class={`text-[10px] md:text-[11px] tracking-[0.24em] font-semibold uppercase leading-tight ${inverted ? 'text-rose-200' : 'text-[#2B2024]'}`}>
        Salon &amp; Academy
      </span>
      <span class={`text-[9px] tracking-wider uppercase font-medium mt-0.5 ${inverted ? 'text-rose-200/60' : 'text-[#C4845A]'}`}>
        Mahad &bull; Women-Owned
      </span>
    </div>
  </div>
)}
