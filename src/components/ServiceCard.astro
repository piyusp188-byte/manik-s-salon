---
import type { ServiceItem } from '../data/siteData';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const categoryIcons: Record<string, string> = {
  makeup: '✨',
  mehndi: '🌿',
  facial: '💧',
  skincare: '🌸',
  haircare: '💇‍♀️',
  pedicure: '🦶'
};
---

<article 
  id={service.id}
  class="group relative flex flex-col justify-between rounded-2xl bg-white border border-[#E8D9DE] p-6 sm:p-7 hover:border-[#6B2D5E]/60 transition-all duration-300 shadow-sm hover:shadow-md scroll-mt-24"
>
  <div>
    <!-- Top Meta -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="text-2xl" aria-hidden="true">
        {categoryIcons[service.category] || '✨'}
      </span>
      <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
        {service.category}
      </span>
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-2xl font-display font-bold text-[#2B2024] group-hover:text-[#6B2D5E] transition-colors">
      {service.name}
    </h3>
    <p class="text-xs text-[#C4845A] font-semibold mt-1">
      {service.tagline}
    </p>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-[#5A4553] mt-3 leading-relaxed">
      {service.description}
    </p>

    <!-- Highlights checklist -->
    <ul class="mt-4 space-y-2 text-xs text-[#2B2024] border-t border-[#E8D9DE]/60 pt-3.5">
      {service.highlights.map((item) => (
        <li class="flex items-start gap-2">
          <svg class="w-3.5 h-3.5 text-[#6B2D5E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <!-- Photo Placeholder Notice -->
    <div class="mt-4 p-3 rounded-xl bg-[#FFF9F5] border border-dashed border-[#E8D9DE] text-[11px] text-[#5A4553] flex items-center gap-2">
      <svg class="w-4 h-4 text-[#C4845A] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span><strong class="text-[#2B2024]">Photo Note:</strong> {service.photoPlaceholderNote}</span>
    </div>
  </div>

  <!-- Bottom CTA & Price Placeholder -->
  <div class="mt-6 pt-4 border-t border-[#E8D9DE]/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div>
      <span class="block text-[11px] uppercase tracking-wider text-[#7A6672] font-semibold">Pricing</span>
      <span class="text-xs font-semibold text-[#6B2D5E]">{service.pricePlaceholder}</span>
    </div>

    <button
      type="button"
      onclick={`window.openEnquiryModal('Service: ${service.name}')`}
      class="w-full sm:w-auto px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] rounded-xl shadow-sm transition-all cursor-pointer"
    >
      Book Service
    </button>
  </div>
</article>
