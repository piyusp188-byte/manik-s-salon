---
import type { ServiceItem } from '../data/siteData';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const serviceImages: Record<string, { src: string; alt: string }> = {
  'bridal-makeup': { src: '/images/gallery/bridal-makeup.webp', alt: 'Bridal makeup artistry with skin-tone matching' },
  'self-makeup': { src: '/images/gallery/party-makeup.webp', alt: 'Self-makeup and celebration party glam' },
  'mehndi': { src: '/images/gallery/bridal-mehndi.webp', alt: 'Traditional bridal and festive henna art' },
  'hydra-facial': { src: '/images/gallery/hydra-facial.webp', alt: 'Hydra facial deep pore cleansing treatment' },
  'skincare': { src: '/images/gallery/skincare-therapy.webp', alt: 'Customized skincare and hydration routine' },
  'haircare': { src: '/images/gallery/hair-spa.webp', alt: 'Intensive hair spa and blow-dry styling' },
  'pedicure': { src: '/images/gallery/pedicure.webp', alt: 'Deluxe pedicure foot soak and nail care' }
};

const imgData = serviceImages[service.id];
---

<article 
  id={service.id}
  class="group relative flex flex-col justify-between rounded-2xl bg-white border border-[#E8D9DE] overflow-hidden hover:border-[#6B2D5E]/60 transition-all duration-300 shadow-sm hover:shadow-lg scroll-mt-24"
>
  <div>
    <!-- Service Thumbnail Photo -->
    {imgData && (
      <div class="aspect-[16/9] w-full overflow-hidden relative bg-[#FBEFF1]">
        <img
          src={imgData.src}
          alt={imgData.alt}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
          class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
        <div class="absolute top-3 right-3">
          <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white bg-[#6B2D5E]/85 backdrop-blur-md rounded-full shadow-sm">
            {service.category}
          </span>
        </div>
      </div>
    )}

    <!-- Card Content -->
    <div class="p-6 sm:p-7">
      <!-- Title & Tagline -->
      <h3 class="text-2xl font-display font-bold text-[#2B2024] group-hover:text-[#6B2D5E] transition-colors">
        {service.name}
      </h3>
      <p class="text-xs text-[#C4845A] font-semibold mt-1">
        {service.tagline}
      </p>

      <!-- Description -->
      <p class="text-xs sm:text-sm text-[#5A4553] mt-3 leading-relaxed">
        {service.description}
      </p>

      <!-- Highlights checklist -->
      <ul class="mt-4 space-y-2 text-xs text-[#2B2024] border-t border-[#E8D9DE]/60 pt-3.5">
        {service.highlights.map((item) => (
          <li class="flex items-start gap-2">
            <svg class="w-3.5 h-3.5 text-[#6B2D5E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom CTA & Price Placeholder -->
  <div class="px-6 pb-6 sm:px-7 sm:pb-7 pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-t border-[#E8D9DE]/60">
    <div>
      <span class="block text-[11px] uppercase tracking-wider text-[#7A6672] font-semibold">Pricing</span>
      <span class="text-xs font-semibold text-[#6B2D5E]">{service.pricePlaceholder}</span>
    </div>

    <button
      type="button"
      onclick={`window.openEnquiryModal('Service: ${service.name}')`}
      class="w-full sm:w-auto px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] rounded-xl shadow-sm transition-all cursor-pointer"
    >
      Book Service
    </button>
  </div>
</article>
