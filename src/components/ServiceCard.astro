---
import type { ServiceItem } from '../data/siteData';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const categoryIcons: Record<string, string> = {
  makeup: '✨',
  mehndi: '🌿',
  facial: '💧',
  skincare: '🌸',
  haircare: '💇‍♀️',
  pedicure: '🦶'
};
---

<article 
  id={service.id}
  class="group relative flex flex-col justify-between rounded-2xl bg-stone-900/60 border border-stone-800/80 p-6 sm:p-7 hover:border-amber-500/40 hover:bg-stone-900/90 transition-all duration-300 shadow-lg hover:shadow-amber-500/5 scroll-mt-24"
>
  <div>
    <!-- Top Meta -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="text-2xl" aria-hidden="true">
        {categoryIcons[service.category] || '✨'}
      </span>
      <span class="px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-300 bg-amber-500/10 border border-amber-500/20 rounded-full">
        {service.category}
      </span>
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-xl font-serif font-bold text-stone-100 group-hover:text-amber-200 transition-colors">
      {service.name}
    </h3>
    <p class="text-xs text-amber-300/80 font-medium mt-1">
      {service.tagline}
    </p>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-stone-300 mt-3 leading-relaxed">
      {service.description}
    </p>

    <!-- Highlights checklist -->
    <ul class="mt-4 space-y-1.5 text-xs text-stone-300 border-t border-stone-800/80 pt-3">
      {service.highlights.map((item) => (
        <li class="flex items-start gap-2">
          <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <!-- Photo Placeholder Notice -->
    <div class="mt-4 p-2.5 rounded-lg bg-stone-950/70 border border-dashed border-stone-700 text-[11px] text-stone-400 flex items-center gap-2">
      <svg class="w-4 h-4 text-amber-400/80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span><strong class="text-stone-300">Photo Note:</strong> {service.photoPlaceholderNote}</span>
    </div>
  </div>

  <!-- Bottom CTA & Price Placeholder -->
  <div class="mt-6 pt-4 border-t border-stone-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div>
      <span class="block text-[11px] uppercase tracking-wider text-stone-500 font-semibold">Pricing</span>
      <span class="text-xs font-medium text-amber-300/90">{service.pricePlaceholder}</span>
    </div>

    <button
      type="button"
      onclick={`window.openEnquiryModal('Service: ${service.name}')`}
      class="w-full sm:w-auto px-4 py-2 text-xs font-bold uppercase tracking-wider text-stone-950 bg-gradient-to-r from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 rounded-lg shadow transition-all cursor-pointer"
    >
      Book Service
    </button>
  </div>
</article>
