---
import type { CourseItem } from '../data/siteData';

interface Props {
  course: CourseItem;
}

const { course } = Astro.props;
---

<article 
  id={course.id}
  class="flex flex-col justify-between rounded-2xl bg-white border border-[#E8D9DE] p-6 sm:p-8 hover:border-[#6B2D5E]/60 transition-all duration-300 shadow-sm hover:shadow-md scroll-mt-24"
>
  <div>
    <!-- Badges -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#FBEFF1] border border-[#E8D9DE] rounded-full">
        {course.level}
      </span>
      <span class="text-xs text-[#5A4553] font-medium">
        Hands-On Practical Training
      </span>
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-2xl sm:text-3xl font-display font-bold text-[#2B2024]">
      {course.title}
    </h3>
    <p class="text-xs sm:text-sm text-[#C4845A] font-semibold mt-1">
      {course.tagline}
    </p>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-[#5A4553] mt-3 leading-relaxed">
      {course.description}
    </p>

    <!-- Curriculum -->
    <div class="mt-5 pt-4 border-t border-[#E8D9DE]/60">
      <h4 class="text-xs font-bold uppercase tracking-wider text-[#2B2024] mb-2.5">
        What You Will Master:
      </h4>
      <ul class="space-y-2 text-xs text-[#5A4553]">
        {course.curriculum.map((item) => (
          <li class="flex items-start gap-2">
            <svg class="w-3.5 h-3.5 text-[#6B2D5E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Audience -->
    <div class="mt-4 p-3.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE] text-xs text-[#5A4553]">
      <strong class="text-[#2B2024]">Ideal For:</strong> {course.audience}
    </div>

    <!-- Duration & Batch Placeholders -->
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
      <div class="p-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE]/70">
        <span class="block text-[10px] uppercase font-bold text-[#7A6672]">Duration</span>
        <span class="text-[#2B2024] font-medium">{course.durationPlaceholder}</span>
      </div>
      <div class="p-2.5 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE]/70">
        <span class="block text-[10px] uppercase font-bold text-[#7A6672]">Schedule</span>
        <span class="text-[#2B2024] font-medium">{course.batchInfoPlaceholder}</span>
      </div>
    </div>
  </div>

  <!-- Bottom CTA & Fee Placeholder -->
  <div class="mt-6 pt-5 border-t border-[#E8D9DE]/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <span class="block text-[10px] uppercase tracking-wider text-[#7A6672] font-semibold">Course Fee</span>
      <span class="text-xs sm:text-sm font-bold text-[#6B2D5E]">{course.feePlaceholder}</span>
    </div>

    <button
      type="button"
      onclick={`window.openEnquiryModal('Academy Course: ${course.title}')`}
      class="w-full sm:w-auto px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-[#6B2D5E] hover:bg-[#4E1E45] rounded-xl shadow-sm transition-all cursor-pointer"
    >
      Enquire for Admission
    </button>
  </div>
</article>
