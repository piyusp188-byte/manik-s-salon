---
import type { CourseItem } from '../data/siteData';

interface Props {
  course: CourseItem;
}

const { course } = Astro.props;
---

<article 
  id={course.id}
  class="flex flex-col justify-between rounded-2xl bg-stone-900/60 border border-stone-800/80 p-6 sm:p-8 hover:border-amber-500/40 hover:bg-stone-900/90 transition-all duration-300 shadow-xl scroll-mt-24"
>
  <div>
    <!-- Badges -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded-full">
        {course.level}
      </span>
      <span class="text-xs text-stone-400 font-medium">
        Hands-On Practical Training
      </span>
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-100">
      {course.title}
    </h3>
    <p class="text-xs sm:text-sm text-amber-300/80 font-medium mt-1">
      {course.tagline}
    </p>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-stone-300 mt-3 leading-relaxed">
      {course.description}
    </p>

    <!-- Curriculum -->
    <div class="mt-5 pt-4 border-t border-stone-800">
      <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-2.5">
        What You Will Master:
      </h4>
      <ul class="space-y-1.5 text-xs text-stone-300">
        {course.curriculum.map((item) => (
          <li class="flex items-start gap-2">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Audience -->
    <div class="mt-4 p-3 rounded-lg bg-stone-950/70 border border-stone-800 text-xs text-stone-300">
      <strong class="text-amber-200">Ideal For:</strong> {course.audience}
    </div>

    <!-- Duration & Batch Placeholders -->
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-stone-400">
      <div class="p-2 rounded bg-stone-950/40 border border-stone-800">
        <span class="block text-[10px] uppercase font-semibold text-stone-500">Duration</span>
        <span class="text-stone-300 font-medium">{course.durationPlaceholder}</span>
      </div>
      <div class="p-2 rounded bg-stone-950/40 border border-stone-800">
        <span class="block text-[10px] uppercase font-semibold text-stone-500">Schedule</span>
        <span class="text-stone-300 font-medium">{course.batchInfoPlaceholder}</span>
      </div>
    </div>
  </div>

  <!-- Bottom CTA & Fee Placeholder -->
  <div class="mt-6 pt-5 border-t border-stone-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <span class="block text-[10px] uppercase tracking-wider text-stone-500 font-semibold">Course Fee</span>
      <span class="text-xs sm:text-sm font-semibold text-amber-300">{course.feePlaceholder}</span>
    </div>

    <button
      type="button"
      onclick={`window.openEnquiryModal('Academy Course: ${course.title}')`}
      class="w-full sm:w-auto px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-stone-950 bg-gradient-to-r from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 rounded-lg shadow-md transition-all cursor-pointer"
    >
      Enquire for Batch Admission
    </button>
  </div>
</article>
