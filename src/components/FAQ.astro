---
import { FAQS } from '../data/siteData';

// Generate FAQPage JSON-LD Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-16 sm:py-24 bg-[#FBEFF1]" aria-labelledby="faq-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[#6B2D5E] bg-[#6B2D5E]/10 px-3 py-1 rounded-full">
        Got Questions?
      </span>
      <h2 id="faq-heading" class="mt-4 text-3xl sm:text-4xl font-display font-bold text-[#2B2024]">
        Frequently Asked Questions
      </h2>
      <p class="mt-3 text-base text-[#5A4553]">
        Everything you need to know about salon bookings, location, and academy classes at Monik's in Mahad.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {FAQS.map((faq, index) => (
        <details
          class="group bg-white rounded-2xl border border-[#E8D9DE] overflow-hidden transition-all duration-200 open:shadow-md open:border-[#6B2D5E]/40"
          open={index === 0}
        >
          <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 text-left cursor-pointer list-none select-none font-semibold text-[#2B2024] hover:text-[#6B2D5E] focus-visible:outline-2 focus-visible:outline-[#6B2D5E]">
            <span class="text-base sm:text-lg">{faq.question}</span>
            <span class="shrink-0 w-8 h-8 rounded-full bg-[#FFF9F5] border border-[#E8D9DE] flex items-center justify-center text-[#6B2D5E] transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-sm sm:text-base text-[#5A4553] leading-relaxed border-t border-[#E8D9DE]/50 pt-4">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>

  <!-- FAQPage Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
