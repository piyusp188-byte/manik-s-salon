---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith('http') ? item.url : `https://monikssalon.com${item.url}`
  }))
};
---

<nav aria-label="Breadcrumb" class="py-3 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-xs text-stone-400">
  <ol class="flex items-center flex-wrap gap-2">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {index > 0 && <span class="text-stone-600">&sol;</span>}
          {isLast ? (
            <span class="text-amber-300 font-semibold" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-amber-200 transition-colors">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
