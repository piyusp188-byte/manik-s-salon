---
import { SITE_CONFIG } from '../data/siteData';
---

<section class="bg-white border-y border-[#E8D9DE] py-6 px-4 sm:px-6 lg:px-8 shadow-sm" aria-label="Key highlights">
  <div class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- 4.7 Rating -->
    <div class="flex items-center gap-3.5 p-3 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE]/60">
      <div class="w-10 h-10 rounded-lg bg-[#6B2D5E]/10 flex items-center justify-center shrink-0 text-[#E8A020]">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      </div>
      <div>
        <p class="font-bold text-[#2B2024] text-sm sm:text-base leading-tight">4.7 Google Rating</p>
        <p class="text-xs text-[#5A4553]">From 218 local reviews</p>
      </div>
    </div>

    <!-- Women-Owned -->
    <div class="flex items-center gap-3.5 p-3 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE]/60">
      <div class="w-10 h-10 rounded-lg bg-[#6B2D5E]/10 flex items-center justify-center shrink-0 text-[#6B2D5E]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
      <div>
        <p class="font-bold text-[#2B2024] text-sm sm:text-base leading-tight">Women-Owned</p>
        <p class="text-xs text-[#5A4553]">Safe &amp; welcoming salon</p>
      </div>
    </div>

    <!-- Beauty Academy -->
    <div class="flex items-center gap-3.5 p-3 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE]/60">
      <div class="w-10 h-10 rounded-lg bg-[#6B2D5E]/10 flex items-center justify-center shrink-0 text-[#6B2D5E]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
        </svg>
      </div>
      <div>
        <p class="font-bold text-[#2B2024] text-sm sm:text-base leading-tight">Beauty Academy</p>
        <p class="text-xs text-[#5A4553]">Taught like a friend</p>
      </div>
    </div>

    <!-- Pocket-Friendly -->
    <div class="flex items-center gap-3.5 p-3 rounded-xl bg-[#FFF9F5] border border-[#E8D9DE]/60">
      <div class="w-10 h-10 rounded-lg bg-[#6B2D5E]/10 flex items-center justify-center shrink-0 text-[#C4845A]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
      </div>
      <div>
        <p class="font-bold text-[#2B2024] text-sm sm:text-base leading-tight">Pocket-Friendly</p>
        <p class="text-xs text-[#5A4553]">Honest, quality pricing</p>
      </div>
    </div>
  </div>
</section>

