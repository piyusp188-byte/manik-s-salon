---
// PageLoader.astro - Luxury entrance preloader matching the reference site animation
---

<div id="page-loader" class="page-loader" aria-hidden="true">
  <div class="loader-content">
    <div class="loader-monogram-wrap">
      <span class="loader-monogram">M</span>
      <div class="loader-ring"></div>
      <div class="loader-glow"></div>
    </div>
    <div class="loader-text-group">
      <span class="loader-brand">MONIK'S SALON &amp; ACADEMY</span>
      <span class="loader-sub">MAHAD &bull; WOMEN-OWNED</span>
    </div>
    <div class="loader-bar-wrap">
      <div class="loader-bar-fill"></div>
    </div>
  </div>
</div>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    background: #1B1217;
    background: radial-gradient(circle at center, #2B1824 0%, #150D12 100%);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
  }

  .page-loader.loaded {
    opacity: 0;
    transform: translateY(-8px) scale(1.02);
    visibility: hidden;
    pointer-events: none;
  }

  .loader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
  }

  .loader-monogram-wrap {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .loader-monogram {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 3.75rem;
    font-weight: 700;
    color: #E5B972;
    background: linear-gradient(135deg, #FFF0D4 0%, #E5B972 50%, #C4845A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: loader-pulse 1.4s ease-in-out infinite;
    line-height: 1;
    z-index: 2;
  }

  .loader-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1.5px solid rgba(229, 185, 114, 0.25);
    border-top-color: #E5B972;
    animation: loader-spin 2s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
    z-index: 1;
  }

  .loader-glow {
    position: absolute;
    inset: 10px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(229, 185, 114, 0.25) 0%, transparent 70%);
    animation: loader-glow-pulse 1.4s ease-in-out infinite;
    z-index: 0;
  }

  .loader-brand {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: #FBEFF1;
    margin-bottom: 0.35rem;
    animation: loader-fade-in 0.8s ease-out forwards;
  }

  .loader-sub {
    display: block;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #C4845A;
  }

  .loader-bar-wrap {
    margin-top: 1.5rem;
    width: 120px;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .loader-bar-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #6B2D5E, #E5B972, #C4845A);
    animation: loader-bar 1.6s ease-in-out infinite;
  }

  @keyframes loader-pulse {
    0%, 100% { opacity: 0.45; transform: scale(0.94); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  @keyframes loader-glow-pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.9); }
    50% { opacity: 0.8; transform: scale(1.15); }
  }

  @keyframes loader-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes loader-bar {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  @keyframes loader-fade-in {
    0% { opacity: 0; transform: translateY(6px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader {
      display: none !important;
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      loader.style.display = 'none';
      return;
    }

    const hide = () => {
      loader.classList.add('loaded');
      setTimeout(() => {
        loader.style.display = 'none';
      }, 800);
    };

    // Smooth reveal when page assets load, or max 1200ms timeout
    if (document.readyState === 'complete') {
      setTimeout(hide, 450);
    } else {
      window.addEventListener('load', () => setTimeout(hide, 400));
      setTimeout(hide, 1300); // Safety fallback so user is never blocked
    }
  })();
</script>
