---
import Logo from './Logo.astro';
import { SITE_CONFIG, SERVICES, COURSES } from '../data/siteData';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#2B2024] border-t border-[#4E1E45] text-rose-100/70 text-sm">
  <!-- Upper footer with trust highlights -->
  <div class="border-b border-white/10 bg-[#4E1E45]/40 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
      <!-- 4.7 Rating Callout -->
      <div class="flex flex-col md:flex-row items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10">
        <div class="w-12 h-12 rounded-full bg-[#E8A020]/20 border border-[#E8A020]/40 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6 text-[#E8A020] fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-white">Google 4.7★ Rating</h4>
          <p class="text-xs text-rose-200/70 mt-0.5">Based on 218 authentic client reviews in Mahad</p>
        </div>
      </div>

      <!-- Women-Owned Business -->
      <div class="flex flex-col md:flex-row items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10">
        <div class="w-12 h-12 rounded-full bg-[#6B2D5E]/60 border border-rose-300/30 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6 text-rose-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-white">Women-Owned &amp; Operated</h4>
          <p class="text-xs text-rose-200/70 mt-0.5">A secure, comfortable, and welcoming sanctuary for women</p>
        </div>
      </div>

      <!-- Professional Academy -->
      <div class="flex flex-col md:flex-row items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10">
        <div class="w-12 h-12 rounded-full bg-[#C4845A]/20 border border-[#C4845A]/40 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6 text-[#E0A683]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-white">Hands-on Beauty Academy</h4>
          <p class="text-xs text-rose-200/70 mt-0.5">Learn makeup, mehndi, and skin therapies with friendly mentorship</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main footer content -->
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
    <!-- Col 1: Business Identity & NAP -->
    <div class="space-y-4">
      <a href="/" aria-label="Monik's Salon & Academy Home">
        <Logo variant="full" />
      </a>
      <p class="text-xs leading-relaxed text-rose-200/70">
        Your trusted local beauty salon and makeup academy in Mahad. Specializing in skin-tone-matched bridal makeup, mehndi designs, hydra facials, and certified beauty training.
      </p>

      <div class="space-y-2.5 pt-3 border-t border-white/10 text-xs text-rose-100">
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-rose-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>
            {SITE_CONFIG.address.street}, {SITE_CONFIG.address.locality}, {SITE_CONFIG.address.city}, {SITE_CONFIG.address.state} {SITE_CONFIG.address.postalCode}
          </span>
        </div>

        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-rose-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <a href={`tel:${SITE_CONFIG.phoneTel}`} class="hover:text-white transition-colors">
            {SITE_CONFIG.phoneInternational}
          </a>
        </div>

        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-rose-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
          </svg>
          <span class="text-rose-200/60">Plus Code: {SITE_CONFIG.address.plusCode}</span>
        </div>
      </div>
    </div>

    <!-- Col 2: Services -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4">
        Salon Services
      </h3>
      <ul class="space-y-2 text-xs">
        {SERVICES.map((s) => (
          <li>
            <a href={`/services/#${s.id}`} class="hover:text-white transition-colors flex items-center justify-between py-0.5">
              <span>{s.name}</span>
              <span class="text-[10px] text-rose-300/40">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Col 3: Academy Courses & Hours -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4">
        Beauty Academy
      </h3>
      <ul class="space-y-2 text-xs mb-6">
        {COURSES.map((c) => (
          <li>
            <a href={`/academy/#${c.id}`} class="hover:text-white transition-colors flex items-center justify-between py-0.5">
              <span>{c.title}</span>
              <span class="text-[10px] text-rose-300/40">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>

      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-2">
        Working Hours
      </h3>
      <div class="text-xs space-y-1 text-rose-100/90 bg-white/5 p-3.5 rounded-xl border border-white/10">
        <p><strong class="text-white">Mon &ndash; Sat:</strong> 10:00 AM &ndash; 8:00 PM</p>
        <p><strong class="text-white">Sunday:</strong> Opens 9:00 AM &ndash; 8:00 PM</p>
        <p class="text-[11px] text-rose-300/80 pt-1.5 border-t border-white/10 mt-1.5">
          *Diwali and festival hours may vary. Please confirm appointment via phone/WhatsApp.
        </p>
      </div>
    </div>

    <!-- Col 4: Quick Navigation & Maps -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4">
        Quick Links &amp; Map
      </h3>
      <ul class="space-y-1.5 text-xs mb-4">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li><a href="/services/" class="hover:text-white transition-colors">All Services &amp; Pricing Details</a></li>
        <li><a href="/academy/" class="hover:text-white transition-colors">Academy Courses &amp; Enrolment</a></li>
        <li><a href="/about/" class="hover:text-white transition-colors">About Our Salon &amp; Team</a></li>
        <li><a href="/gallery/" class="hover:text-white transition-colors">Work Gallery &amp; Photos</a></li>
        <li><a href="/reviews/" class="hover:text-white transition-colors">Google Client Reviews (4.7★)</a></li>
        <li><a href="/contact/" class="hover:text-white transition-colors">Contact &amp; Location Directions</a></li>
      </ul>

      <div class="pt-2">
        <a
          href={SITE_CONFIG.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 w-full justify-center px-3 py-2.5 text-xs font-semibold text-white bg-[#6B2D5E] hover:bg-[#4E1E45] border border-white/20 rounded-xl transition-colors shadow-sm"
        >
          <svg class="w-4 h-4 text-rose-200" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
          </svg>
          Get Directions on Google Maps
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar with Copyright -->
  <div class="border-t border-white/10 py-6 px-4 sm:px-6 lg:px-8 text-xs text-rose-200/50">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>&copy; {currentYear} {SITE_CONFIG.businessName}. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span>M.G Road, Bazar Peth, Mahad, Maharashtra 402301</span>
        <span>&bull;</span>
        <span class="text-rose-200 font-medium">Women-Owned Business</span>
      </p>
    </div>
  </div>
</footer>
